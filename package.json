{
  "name": "access-ripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "start:api": "node dist/api/server.js",
    "build": "tsc -p tsconfig.build.json",
