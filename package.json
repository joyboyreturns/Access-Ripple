{
  "name": "access-ripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "start:api": "node dist/api/server.js",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "dev:web": "vite --config vite.config.ts",
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "demo": "node scripts/demo.mjs",
    "check:studio": "node scripts/check-studio.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "start": "node dist/api/server.js",
    "prepare:demo": "node scripts/prepare-demo.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "axe-core": "^4.14.0",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "motion": "^14.4.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
