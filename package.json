    "@fastify/swagger-ui": "^6.1.2",
    "axe-core": "^4.14.0",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
