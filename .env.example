# Local settings for AccessRipple. Copy this file to `.env` and fill it in.
# `.env` stays on this computer and is ignored by git. Never commit a real key.

# Optional. Enables the AI briefing that summarises a finished scan.
# Without a key the app works exactly the same and shows the deterministic
# scan summary instead. The default provider is the Vercel AI Gateway; put an
# AI Gateway API key here (AI_GATEWAY_API_KEY is read too). Any
# OpenAI-compatible chat-completions endpoint works.
ACCESSRIPPLE_AI_KEY=
ACCESSRIPPLE_AI_BASE_URL=https://ai-gateway.vercel.sh/v1
ACCESSRIPPLE_AI_MODEL=minimax/minimax-m3.1-flash

# Optional. Tried in order when the model above is busy or unavailable.
# Empty by default. Example: deepseek/deepseek-v4.1-flash-1017
ACCESSRIPPLE_AI_FALLBACK_MODELS=

# Optional. Reasoning effort for models that think before they answer.
# "low" keeps the answer short enough to arrive in a few seconds.
ACCESSRIPPLE_AI_REASONING_EFFORT=low

# Optional. Used as the referrer sent to the provider.
ACCESSRIPPLE_AI_SITE_URL=https://accessripple.local

# Optional: names the studio may be opened by through a private proxy on the same computer,
# for example `tailscale serve`. Comma-separated. The scanner still listens on loopback only.
ACCESSRIPPLE_TRUSTED_HOSTS=
