# Local settings for AccessRipple. Copy this file to `.env` and fill it in.
# `.env` stays on this computer and is ignored by git. Never commit a real key.

# Optional. Enables the AI briefing that summarises a finished scan.
# Without a key the app works exactly the same and shows the deterministic
# scan summary instead. Any OpenAI-compatible chat-completions endpoint works.
ACCESSRIPPLE_AI_KEY=
ACCESSRIPPLE_AI_BASE_URL=https://openrouter.ai/api/v1
ACCESSRIPPLE_AI_MODEL=minimax/minimax-m3.1-flash:free

# Optional. Used as the referrer sent to the provider.
ACCESSRIPPLE_AI_SITE_URL=https://accessripple.local
